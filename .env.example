# Optional provider credentials. Leave empty until you have verified account keys.
HELIUS_API_KEY=
BIRDEYE_API_KEY=
SOLANA_TRACKER_KEY=

# Telegram alert delivery is only considered configured when both values exist.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Protects journal writes and auto-journal actions. Keep server-side only.
HAWK_CONTROL_TOKEN=

# Backend settings. The default CORS allowlist is localhost Vite development.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DB_PATH=data/hawk_snapshots.db

# Set only if frontend and backend are hosted on different origins.
VITE_API_BASE_URL=
